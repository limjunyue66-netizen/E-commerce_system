APP_NAME=NovaBazaar
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/E-commerce_system
APP_BASE_PATH=/E-commerce_system

DB_HOST=127.0.0.1
DB_NAME=ecommerce
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
# If MySQL root has a password, set DB_PASS above (example: DB_PASS=yourpassword)
# Then import database/ecommerce_marketplace.sql via phpMyAdmin or: php tools/fix_db.php

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=MYR
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
CURRENCY_SYMBOL=RM
CURRENCY_CODE=MYR
BANK_NAME=Maybank Berhad
BANK_ACCOUNT_NAME=NovaBazaar Sdn Bhd
BANK_ACCOUNT_NUMBER=5123 4567 8901

MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@novabazaar.local
MAIL_FROM_NAME=NovaBazaar

SESSION_NAME=novabazaar_session
UPLOAD_MAX_MB=5
SHIPPING_FEE=8.00
FORCE_PASSWORD_CHANGE=true
